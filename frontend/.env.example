# Vite proxies /api and /health to this URL during development and preview.
# The TRUTHSCAN_ prefix is the internal (pre-rebrand) name and is kept for compatibility.
TRUTHSCAN_BACKEND_URL=http://127.0.0.1:8000

# Static deployments only (e.g. Vercel): the backend origin the browser calls directly.
# Leave unset for local development. The backend must list the frontend origin in
# SHODHA_ALLOWED_ORIGINS for cross-origin requests to succeed.
# VITE_API_BASE_URL=https://<user>-shodha-ai.hf.space
